{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block description %}Explorez nos offres d'espace de datacenter pour trouver la plus adaptée à vos besoins.{% endblock %}

{% block body %}
    <section class="d-flex flex-column gap-4 justify-content-center">
        <h1 class="text-center">Bienvenue sur Work Together</h1>
        <hr>
        <h2 class="text-center">Qui sommes-nous ?</h2>
        <p class="text-center">Work Together est une plateforme de location d'espaces en datacenter. Nous vous proposons des offres adaptées à vos besoins, que vous soyez une entreprise ou un particulier.</p>
        <hr>
    </section>
    <section>
        <h2 class="text-center mb-sm-4">Nos offres</h2>
        <div class="d-flex justify-content-evenly flex-sm-wrap flex-md-nowrap flex-column flex-sm-row">
            <div class="d-flex flex-column justify-content-center">
                {{ form(billingTypeForm) }}
            </div>
            <div class="d-flex flex-column flex-sm-row justify-content-start justify-content-sm-evenly align-items-center gap-2">
                {% for offer in offers %}
                    <div class="d-flex flex-column justify-content-evenly rounded border border-1 border-dark-subtle p-2 col-10 col-sm-5 col-sm-3 offer">
                        <div class="mt-1">{{ offer.name }}</div>
                        <div class="mt-1">{{ offer.maxUnits }} unités</div>
                        <div class="monthlyPriceDisplay mt-1" data-rent="{{ offer.monthlyRentPrice }}">{{ offer.monthlyRentPrice }}€/mois</div>
                        <div class="totalPriceDisplay mt-1">0€</div>
                        <form action="{{ path('offer', {'id': offer.id}) }}" class="d-flex justify-content-center">
                            <input class="billingType" type="hidden" name="billing" value="">
                            <button class="btn btn-primary" type="submit">En savoir plus</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('home') }}
{% endblock %}