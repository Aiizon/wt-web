{% extends 'base.html.twig' %}

{% block title %}Vos informations{% endblock %}

{% block description %}Mettez à jour vos informations personnelles.{% endblock %}

{% block body %}
    <div class="d-flex flex-column justify-content-center align-items-center gap-2">
        <h1 class="text-center">Mettez à jour vos informations personnelles</h1>
        {{ form_errors(form) }}

        {{ form_start(form) }}
            {{ form_row(form.firstName) }}
            {{ form_row(form.lastName) }}
            {{ form_row(form.address) }}
            {{ form_row(form.plainPassword) }}
            {{ form_row(form.submit) }}
        {{ form_end(form) }}
        <a href="{{ path('customer_area_profile') }}" class="btn btn-danger">Retour</a>
    </div>
{% endblock %}