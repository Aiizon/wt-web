<!DOCTYPE html>
<html lang="fr-FR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{% block description %}Work Together, louez des unités en datacenter en 3 clics !{% endblock %}">
        <link rel="icon" href="{{ asset('images/favicon.ico') }}">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
        <title>{% block title %}{% endblock %} - Work Together</title>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% if app.environment = "prod" %}
            <script>
                var _paq = window._paq = window._paq || [];
                _paq.push(['trackPageView']);
                _paq.push(['enableLinkTracking']);
                (function() {
                    var u="//analytics.worktogether.com/";
                    _paq.push(['setTrackerUrl', u+'matomo.php']);
                    _paq.push(['setSiteId', '1']);
                    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
                    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
                })();
            </script>
        {% endif %}
    </head>
    <body class="d-flex flex-column container mx-auto justify-content-center align-content-center min-vh-100">
        {{ include('header.html.twig') }}
        <section class="d-flex flex-column justify-content-sm-evenly justify-content-center gap-2 main">
            {% block body %}{% endblock %}
        </section>
        {{ include('flash.html.twig') }}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
        {{ include('footer.html.twig') }}
    </body>
</html>
