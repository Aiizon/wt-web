{% extends 'base.html.twig' %}

{% block title %}Espace client{% endblock %}

{% block description %}Accédez à votre espace client pour gérer vos offres et vos factures.{% endblock %}

{% block body %}
    <div class="d-flex flex-column container my-5 py-5">
        <h1 class="text-center my-5">Mes unités</h1>
        <hr>
        <h2 class="text-center">Statistiques</h2>
        <div class="d-flex flex-row justify-content-evenly row">
            <div class="d-flex flex-column justify-content-center col">
                <span>Total d'unités : {{ stats.totalUnits }}</span>
            </div>
            <div class="d-flex flex-column justify-content-center col">
                <span>Allumées : {{ stats.on }}</span>
                <span>Éteintes : {{ stats.off }}</span>
            </div>
            <div class="d-flex flex-column justify-content-center col">
                <span>OK : {{ stats.ok }}</span>
                <span>KO : {{ stats.ko }}</span>
                <span>Maintenance : {{ stats.maintenance }}</span>
            </div>
        </div>
        <hr/>
        <div class="row">
            <div class="col-12 table-responsive">
                <div class="accordion" id="units-accordion">
                    {% for bayName, bayData in bays %}
                        <div class="accordion-item">
                            <p class="accordion-header" id="heading-{{ bayName }}">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ bayName }}" aria-expanded="true" aria-controls="collapse-{{ bayName }}">
                                    {{ bayName }} <span class="ms-2 badge bg-secondary">{{ bayData.units|length }} unité(s)</span>
                                </button>
                            </p>
                            <div class="accordion-collapse collapse {% if loop.first %}show{% endif %}" id="collapse-{{ bayName }}">
                                <div class="accordion-body">
                                    <table class="table table-striped table-hover table-responsive mb-0">
                                        <thead>
                                            <tr>
                                                <th>Unité</th>
                                                <th>Localisation</th>
                                                <th>Statut</th>
                                                <th>Etat</th>
                                                <th>Usage</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for unit in bayData.units %}
                                                <tr {% if unit.unitUsage %}style="background-color: {{ unit.unitUsage.color }} !important"{% endif %}>
                                                    <td>{{ unit.id }}</td>
                                                    <td><a class="align-self-center" href="{{ path('customer_area_unit_interventions', {'id': unit.id}) }}">{{ unit.name }}, {{ unit.bay.name }} ({{ unit.bay.location }})</a></td>
                                                    <td>{{ unit.isStarted ? 'Allumée' : 'Eteinte' }}</td>
                                                    <td>
                                                        {% if unit.status == 1 %}
                                                            <span class="badge bg-success">OK</span>
                                                        {% elseif unit.status == 2 %}
                                                            <span class="badge bg-danger">KO</span>
                                                        {% elseif unit.status == 3 %}
                                                            <span class="badge bg-secondary">Maintenance</span>
                                                        {% else %}
                                                            Inconnu
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if unit.unitUsage %}
                                                            <span class="badge" style="background-color: {{ unit.unitUsage.color }}">{{ unit.unitUsage.name }}</span>
                                                        {% else %}
                                                            <span class="badge bg-dark">Aucun</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('customer_area_update_unit_config', {'id': unit.id}) }}" class="btn btn-sm btn-info">Configurer</a>
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('customer_area_unit_create_intervention', {'id': unit.id}) }}" class="btn btn-sm btn-success">Demander une intervention</a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-center text-muted">Aucune unité trouvée.</p>
                    {% endfor %}
                </div>
            </div>
        </div>
        <a class="align-self-center btn btn-primary mt-4" href="{{ path('customer_area_home') }}">Retour</a>
    </div>
{% endblock %}