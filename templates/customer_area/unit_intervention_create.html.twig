{% extends 'base.html.twig' %}

{% block body %}
    {{ form_start(form, {'attr': {'class': 'col-md-6 mx-auto'}}) }}
        <h1 class="text-center my-5">Modifier l'usage - Unité #{{ unit.id }}</h1>
        {{ form_widget(form) }}
        <div class="d-flex justify-content-center gap-2 mt-3">
            <button type="submit" class="btn btn-success">Enregistrer</button>
            <a class="align-self-center btn btn-primary" href="{{ path('customer_area_units') }}">Retour</a>
        </div>
    {{ form_end(form) }}
{% endblock %}