<!DOCTYPE html>
<html lang="fr-FR">
    <head>
        <meta charset="UTF-8">
        <title>Facture {{ invoice.number }}</title>
        <style>
            @media print {
                body { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
            }
            body {
                font-family: Arial, sans-serif;
                line-height: 1.6;
                margin: 0;
                padding: 20px;
                color: #333;
            }
            .invoice-header {
                background: #f8f9fa;
                padding: 20px;
                border-bottom: 2px solid #dee2e6;
                margin-bottom: 30px;
            }
            .invoice-info {
                display: flex;
                justify-content: space-between;
                margin-bottom: 30px;
            }
            .company-info, .client-info {
                flex: 1;
            }
            .invoice-number {
                color: #0d6efd;
                font-size: 1.2em;
                font-weight: bold;
            }
            .invoice-table {
                width: 100%;
                border-collapse: collapse;
                margin: 20px 0;
            }
            .invoice-table th, .invoice-table td {
                padding: 12px;
                text-align: left;
                border-bottom: 1px solid #dee2e6;
            }
            .invoice-table th {
                background: #f8f9fa;
            }
            .invoice-total {
                text-align: right;
                margin-top: 30px;
                font-size: 1.1em;
            }
            .total-amount {
                font-weight: bold;
                font-size: 1.2em;
                color: #0d6efd;
            }
        </style>
    </head>
    <body>
        <div class="invoice-header">
            <h1>Facture</h1>
            <div class="invoice-number">N° {{ invoice.number }}</div>
            <div>Date : {{ invoice.date|date('d/m/Y') }}</div>
        </div>

        <div class="invoice-info">
            <div class="company-info">
                <h3>Notre société</h3>
                <p>
                    WorkTogether<br>
                    12 rue des Pommiers Dorés<br>
                    75000 Paris<br>
                    France<br>
                    TVA : FR12345678901
                </p>
            </div>
            <div class="client-info">
                <h3>Adresse de facturation</h3>
                <p>{{ invoice.billingAddress|nl2br }}</p>
            </div>
        </div>

        <table class="invoice-table">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Quantité d'unités</th>
                    <th>Prix unitaire</th>
                    <th>Réduction de prix</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ invoice.rental.offer.name }}</td>
                    <td>{{ invoice.rental.units|length }}</td>
                    {% if invoice.rental.discount and invoice.rental.discount.percentage %}
                        <td>{{ (invoice.rental.offer.monthlyRentPrice * (1 - invoice.rental.discount.amount / 100)) * invoice.rental.units|length }} €</td>
                        <td>-{{ (1 - invoice.rental.discount.amount / 100) }}%</td>
                    {% elseif invoice.rental.discount and not invoice.rental.discount.percentage %}
                        <td>{{ (invoice.rental.offer.monthlyRentPrice - invoice.rental.discount.amount) * invoice.rental.units|length }} €</td>
                        <td>-{{ invoice.rental.discount.amount }} €</td>
                    {% else %}
                        <td>{{ invoice.rental.offer.monthlyRentPrice * invoice.rental.units|length }} €</td>
                        <td>0 €</td>
                    {% endif %}
                    <td>{{ invoice.totalRentPrice }} €</td>
                </tr>
            </tbody>
        </table>

        <div class="invoice-total">
            <p>Total HT : {{ invoice.totalRentPrice }} €</p>
            <p>TVA (20%) : {{ invoice.totalRentPrice * 0.2 }} €</p>
            <p class="total-amount">Total TTC : {{ invoice.totalRentPrice * 1.2 }} €</p>
        </div>

        <footer style="margin-top: 50px; text-align: center; font-size: 0.9em; color: #6c757d;">
            <p>Merci de votre confiance</p>
        </footer>
    </body>
</html>