<header class="position-absolute top-0 start-0 d-flex justify-content-center align-content-center vw-100 p-4 bg-dark-subtle">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark-subtle">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('home') }}">
                <img src="{{ asset('images/logo.png') }}" alt="logo de Work Together" width="30" class="d-inline-block align-text-top rounded-1">
                Work Together
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="d-flex flex-row align-items-center justify-content-center nav-item">
                        <a class="nav-link" href="{{ path('home') }}">Accueil</a>
                        {% if is_granted('ROLE_USER') %}
                            <a class="nav-link" href="{{ path('logout') }}">Déconnection</a>
                            <a class="nav-link text-center" href="{{ path('customer_area_home') }}">Espace<br/>utilisateur</a>
                        {% else %}
                            <a class="nav-link" href="{{ path('login') }}">Connection</a>
                            <a class="nav-link" href="{{ path('register') }}">Inscription</a>
                        {% endif %}
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>