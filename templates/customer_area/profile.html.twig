{% extends 'base.html.twig' %}

{% block title %}Vos informations{% endblock %}

{% block description %}Visualisez vos informations personnelles.{% endblock %}

{% block body %}
    <section class="d-flex flex-column justify-content-center align-items-center mt-4 gap-2">
        <h1 class="text-center">Vos informations actuelles</h1>
        <table class="table table-striped table-hover">
            <tbody>
                <tr>
                    <th>E-mail</th>
                    <td>{{ app.user.email }}</td>
                </tr>
                <tr>
                    <th>Prénom</th>
                    <td>{{ app.user.firstName }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ app.user.lastName }}</td>
                </tr>
                <tr>
                    <th>Adresse</th>
                    <td>{{ app.user.address }}</td>
                </tr>
            </tbody>
        </table>
        <div class="d-flex flex-row gap-2">
            <a href="{{ path('customer_area_profile_edit') }}" class="btn btn-info">Mettre à jour</a>
            <a href="{{ path('customer_area_tokens') }}" class="btn btn-info">Gérer mes jetons</a>
        </div>
        <a href="{{ path('customer_area_profile_delete') }}" class="btn btn-danger" onclick="return confirm('Êtes-vous sûrs de vouloir votre compte ?');">Supprimer mon compte</a>
        <a class="align-self-center btn btn-primary" href="{{ path('customer_area_home') }}">Retour</a>
    </section>
{% endblock %}