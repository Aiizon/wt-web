<!DOCTYPE html>
<html lang="fr-FR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{% block description %}Work Together, louez des unités en datacenter en 3 clics !{% endblock %}">
        <title>{% block title %}{% endblock %} - Work Together</title>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    <body class="d-flex flex-column container mx-auto justify-content-center align-content-center min-vh-100">
        {{ include('header.html.twig') }}
        <section class="d-flex flex-column justify-content-evenly gap-2" style="min-height: 80vh; margin-top: 10vh;">
            {% block body %}{% endblock %}
        </section>
        {{ include('flash.html.twig') }}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </body>
</html>
