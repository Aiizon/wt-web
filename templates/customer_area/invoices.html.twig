{% extends 'base.html.twig' %}

{% block title %}Espace client{% endblock %}

{% block description %}Accédez à votre espace client pour gérer vos offres et vos factures.{% endblock %}

{% block body %}
    <div class="d-flex flex-column gap-2 container mx-auto px-4 py-8">
        <h1 class="text-center my-5">Mes factures</h1>
        {% for month, monthInvoices in invoices %}
            <div class="d-flex flex-column mb-8">
                <h2 class="text-xl fw-semibold mb-4">{{ month|date('F Y') }}</h2>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Numéro</th>
                            <th>Date</th>
                            <th>Voir</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for invoice in monthInvoices %}
                            <tr>
                                <td>{{ invoice.number }}</td>
                                <td>{{ invoice.date|date('d/m/Y') }}</td>
                                <td>
                                    <a href="{{ path('invoice_show', {id: invoice.id}) }}" target="_blank">
                                        Voir le PDF
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if not loop.last %}
                <hr class="border-gray-300">
            {% endif %}
        {% else %}
            <p class="text-center text-gray-500">Aucune facture trouvée.</p>
        {% endfor %}
        <a class="align-self-center btn btn-primary" href="{{ path('customer_area_home') }}">Retour</a>
    </div>
{% endblock %}