{% extends 'base.html.twig' %}

{% block title %}Offre {{ offer.name }}{% endblock %}

{% block description %}Découvrez l'offre {{ offer.name }} et d'autres adaptées aux besoins de votre entreprise.{% endblock %}

{% block body %}
    <div class="d-flex flex-row justify-content-evenly align-content-center">
        <div class="d-flex flex-column justify-content-evenly">
            <h1>{{ offer.name }}</h1>
            <p id="unitAmount" data-unit-amount="{{ offer.maxUnits }}">Unité(s) : {{ offer.maxUnits }}</p>
            <p>Disponibilité : {{ offer.availability }}</p>
            <p>Bande passante : {{ offer.bandwidth }}</p>
        </div>
        <div class="d-flex flex-column justify-content-evenly">
            {{ form(billingTypeForm) }}
            {{ form(rentQuantityForm) }}
            <p class="monthlyPriceDisplay" data-rent="{{ offer.monthlyRentPrice }}">Prix mensuel : {{ offer.monthlyRentPrice }} €</p>
            <p>Prix unitaire : <span class="unitPriceDisplay">0€</span></p>
            <p>Prix total : <span class="totalPriceDisplay">0€</span></p>
            <form action="{{ path('rent', {'id': offer.id}) }}">
                <input class="billingType" type="hidden" name="billing" value="">
                <input class="rentQuantity" type="hidden" name="quantity" value="">
                <button class="btn btn-primary" type="submit">Commander</button>
                <p id="availableDisplay" class="text-success">Disponible</p>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('offerDetails') }}
{% endblock %}