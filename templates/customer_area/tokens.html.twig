{% extends 'base.html.twig' %}

{% block body %}
    <section class="d-flex flex-column justify-content-center">
        <h1 class="text-center">Vos jetons actuels</h1>
    </section>
    <section class="d-flex flex-column justify-content-center align-items-center mt-4 gap-2">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Date de création</th>
                    <th>Supprimer</th>
                </tr>
            </thead>
            <tbody>
                {% for token in tokens %}
                    <tr>
                        <td>{{ token.description }}</td>
                        <td>{{ token.createdAt|date('d/m/Y H:i:s') }}</td>
                        <td>
                            <a href="{{ path('customer_area_token_delete', {'id': token.id}) }}" class="btn btn-danger">Supprimer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <a href="{{ path('customer_area_token_create') }}" class="btn btn-info">Générer un jeton</a>
        <a class="align-self-center btn btn-primary" href="{{ path('customer_area_home') }}">Retour</a>
    </section>
{% endblock %}