{% extends 'base.html.twig' %}

{% block title %}Espace client{% endblock %}

{% block description %}Accédez à votre espace client pour gérer vos offres et vos factures.{% endblock %}

{% block body %}
    <section class="d-flex flex-column justify-content-center">
        <h1 class="text-center">Votre espace client</h1>
    </section>
    <section class="d-flex flex-row justify-content-evenly mt-4">
        <div class="p-4 border border-dark-subtle border-2 rounded-4">
            <a href="{{ path('customer_area_profile') }}" class="d-flex flex-column justify-content-center align-items-center text-decoration-none">
                <i class="bi bi-person-fill text-dark" style="font-size: xx-large;"></i>
                <h2 class="text-success">Vos informations</h2>
            </a>
        </div>
        <div class="p-4 border border-dark-subtle border-2 rounded-4">
            <a href="{{ path('customer_area_orders') }}" class="d-flex flex-column justify-content-center align-items-center text-decoration-none">
                <i class="bi bi-cart-check-fill text-dark" style="font-size: xx-large;"></i>
                <h2 class="text-success">Vos commandes</h2>
            </a>
        </div>
        <div class="p-4 border border-dark-subtle border-2 rounded-4">
            <a href="{{ path('customer_area_invoices') }}" class="d-flex flex-column justify-content-center align-items-center text-decoration-none">
                <i class="bi bi-archive-fill text-dark" style="font-size: xx-large;"></i>
                <h2 class="text-success">Vos factures</h2>
            </a>
        </div>
    </section>
{% endblock %}