{% extends 'base.html.twig' %}

{% block title %}Offre {{ offer.name }}{% endblock %}

{% block description %}Découvrez l'offre {{ offer.name }} et d'autres adaptées aux besoins de votre entreprise.{% endblock %}

{% block body %}
    <div class="d-flex flex-row justify-content-evenly align-content-center">
        <div class="d-flex flex-column w-25 justify-content-evenly">
            <h1>{{ offer.name }}</h1>
            <p id="unitAmount" data-unit-amount="{{ offer.maxUnits }}">Unité(s) : {{ offer.maxUnits }}</p>
            <p>Disponibilité : {{ offer.availability }}</p>
            <p>Bande passante : {{ offer.bandwidth }}</p>
        </div>
        <div class="vr"></div>
        <div class="d-flex flex-row w-75 gap-4 justify-content-evenly">
            <div class="d-flex flex-column gap-2">
                {{ form(billingTypeForm) }}
                {{ form(rentQuantityForm) }}
            </div>
            <div class="d-flex flex-column gap-2">
                <p class="monthlyPriceDisplay" data-rent="{{ offer.monthlyRentPrice }}">Prix mensuel : {{ offer.monthlyRentPrice }} €</p>
                <p>Prix unitaire : <span class="unitPriceDisplay">0€</span></p>
                <p>Prix total : <span class="totalPriceDisplay">0€</span></p>
                {% if app.user is null %}
                    <p>Connectez-vous pour commander</p>
                    <a class="btn btn-warning" href="{{ path('login') }}">Se connecter</a>
                {% else %}
                    <form action="{{ path('rent', {'id': offer.id}) }}">
                        <input class="billingType" type="hidden" name="billing" value="">
                        <input class="rentQuantity" type="hidden" name="quantity" value="">
                        <button class="btn btn-primary" type="submit">Commander</button>
                        <p id="availableDisplay" class="text-success">Disponible</p>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
    <section class="d-flex flex-column justify-content-evenly">
        <h2 class="text-center">Ce que disent nos clients</h2>
        {% if feedbackForm %}
            {{ form_errors(feedbackForm) }}
            {{ form_start(feedbackForm, {}) }}
                {{ form_row(feedbackForm.title) }}
                {{ form_row(feedbackForm.content) }}
                {{ form_row(feedbackForm.submit) }}
            {{ form_end(feedbackForm) }}
        {% else %}
            <p class="text-center">Vous devez être connecté pour laisser un avis</p>
        {% endif %}
        <hr>
        <div class="d-flex flex-column justify-content-evenly">
            <div class="d-flex flex-col flex-wrap justify-content-evenly">
                {% for feedback in feedbacks %}
                    <div class="card" style="min-width: 15%">
                        <div class="d-flex flex-row flex-nowrap justify-content-evenly align-items-center gap-2 card-header">
                            <p class="fw-bold text-center">{{ feedback.title }}</p>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('toggle_feedback', {'offerId': offer.id, 'feedbackId': feedback.id}) }}" class="btn btn-dark text-white">
                                    {% if feedback.isVisible %}
                                        <i class="bi bi-eye-slash"></i>
                                    {% else %}
                                        <i class="bi bi-eye-fill"></i>
                                    {% endif %}
                                </a>
                            {% endif %}
                        </div>
                        <p class="text-center">{{ feedback.content }}</p>
                    </div>
                {% else %}
                    <p class="text-center">Aucun avis pour le moment, soyez notre premier !</p>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('offerDetails') }}
{% endblock %}